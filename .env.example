# --- Database ---
DATABASE_URL=postgresql://quittances:password@db:5432/quittances

# --- Auth ---
# URL publique de l'app (CRUCIAL derrière un reverse proxy)
NEXTAUTH_URL=http://localhost:3000
# Générer avec : openssl rand -hex 32
# ⚠️ Minimum 32 caractères — l'app refuse de démarrer si plus court.
NEXTAUTH_SECRET=replace-with-strong-random-secret

# --- Chiffrement des données sensibles (v2) ---
# Clé AES-256-GCM pour chiffrer en base : tokens OAuth, IBAN, emails locataires...
# Générer avec : openssl rand -hex 32
# ⚠️ NE JAMAIS CHANGER après le premier démarrage : les données chiffrées
#    deviendraient illisibles. En cas de rotation, un script de migration
#    est nécessaire.
ENCRYPTION_SECRET=replace-with-32-bytes-hex-key

# --- Google OAuth (login + Gmail API) ---
#
# DEPRECATED v3.2.0 — configuration via UI Paramètres > Intégrations.
# Stockés chiffrés AES-256-GCM dans AppConfig (DB), plus dans .env.
#
# Migration auto au boot (scripts/bootstrap.mjs étape 1quater) : si
# ces env vars sont définies ET DB vide, les valeurs sont copiées
# vers la DB chiffrées au premier démarrage. Vous pouvez ensuite
# retirer ces lignes du .env en toute sécurité.
#
# Conservées pour rétro-compat dev local + premier boot avant
# migration. UI badge "Configuré via .env (legacy)" affiché tant que
# DB pas rempli.
#
# GOOGLE_CLIENT_ID=     (déprécié, utiliser UI)
# GOOGLE_CLIENT_SECRET= (déprécié, utiliser UI)

# --- Stockage local (logos, signatures, archives) ---
UPLOADS_DIR=/app/uploads

# --- Chiffrement applicatif des uploads (v2.9.0) ---
# Clé AES-256-GCM (32 bytes / 256 bits) pour chiffrer les fichiers
# uploadés avant écriture disque. Permet l'app de tourner portable
# sur n'importe quel hébergement (NAS, VPS, Docker, cloud) sans
# dépendre d'une couche système chiffrée native.
# Générer avec : openssl rand -base64 32
# ⚠️ ATTENTION : si vous perdez cette clé, TOUS les uploads chiffrés
#    deviennent IRRÉCUPÉRABLES. Sauvegardez-la séparément du serveur
#    (gestionnaire de mots de passe, coffre-fort).
# ⚠️ NE PAS CHANGER après le premier démarrage sans script de migration.
UPLOADS_ENCRYPTION_KEY=

# --- INSEE IRL (optionnel — laissez vide pour saisir l'IRL manuellement) ---
INSEE_API_KEY=

# --- Backup cloud S3-compatible (v3.1.0 Phase 2, optionnel) ---
# La config principale (endpoint, bucket, credentials, schedule, passphrase
# env.gpg) se fait via l'UI Paramètres > Backup (ADMIN). Cette variable
# d'environnement est facultative et override le destinataire des emails de
# notification (succès/échec backup).
#
# Si non définie : les notifications sont envoyées à tous les Users ADMIN
# actifs (récupérés depuis la DB) avec leur email.
#
# Format : un seul email OU plusieurs séparés par virgule.
# Ex : BACKUP_NOTIFY_EMAIL=ops@example.com,sre@example.com
BACKUP_NOTIFY_EMAIL=

# --- Backup .env path (v3.1.0, optionnel) ---
# Chemin du .env à inclure dans le backup. Default : .env (chemin relatif
# au workdir du container). Override pour les setups avec .env hors-app.
# Ex : BACKUP_ENV_PATH=/run/secrets/openquittance.env
BACKUP_ENV_PATH=

# --- Backup Google Drive OAuth (v3.1.0-rc10 : MIGRÉ DANS L'UI) ---
#
# DEPUIS v3.1.0-rc10, les credentials Drive se configurent dans l'UI :
# Paramètres > Backup > section "Google Drive — Configuration Google Cloud".
# Ils sont stockés chiffrés AES-256-GCM dans AppConfig (DB), plus dans .env.
#
# Migration auto au boot (scripts/bootstrap.mjs) : si ces env vars sont
# encore définies ET la DB est vide, les valeurs sont copiées vers la DB
# au premier démarrage (idempotent — skip si DB déjà rempli). Vous pouvez
# ensuite retirer ces lignes du .env en toute sécurité.
#
# GOOGLE_DRIVE_CLIENT_ID=     (déprécié, utiliser UI)
# GOOGLE_DRIVE_CLIENT_SECRET= (déprécié, utiliser UI)
